# This workspace mixes many unrelated projects (coursework, notes, tools).
# Whitelist approach: everything is ignored by default, only the PianoPal/
# project folder below is tracked. New unrelated folders added later are
# excluded automatically without needing to remember to blacklist them.
/*
!/.gitignore
!/PianoPal/

# Build/dependency artifacts to exclude even within the tracked project dir
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/dist/
**/dist-ssr/
**/*.pyc
**/.DS_Store

# Scratch / generated audio artifacts from local testing
*.wav
*.mp3
*.sf2
