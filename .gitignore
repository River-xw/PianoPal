# This workspace mixes many unrelated projects (coursework, notes, tools).
# Whitelist approach: everything is ignored by default, only the PianoPal
# project directories below (River-xw's backend/frontend/edge/experiments/
# scripts/camera_evidence/data/docs/models layout) are tracked. New unrelated
# folders added later to this shared workspace are excluded automatically
# without needing to remember to blacklist each one.
/*
!/.gitignore
!/README.md
!/backend/
!/frontend/
!/edge/
!/experiments/
!/scripts/
!/camera_evidence/
!/data/
!/docs/
!/models/

# Python environments and caches
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/*.pyc

# Frontend dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/

# OS/editor noise
**/.DS_Store

# Local hardware configuration
edge/microbit_rpi_comm/raspberry/config.json
edge/microbit_rpi_comm/raspberry/config.mac.json

# Scratch / generated audio artifacts from local testing
*.wav
*.mp3
*.sf2

# Local generated data stores
data/db/
data/chroma/
data/raw/sessions/
data/artifacts/sessions/

# Runtime session artifacts (practice_server/session_server write per-run
# guide JSONs, recordings, and grading output here) and the viewer's live
# debug dump -- all regenerated on demand, none belong in git
data/session_scratch/
data/custom_songs/
frontend/viewer/public/last_debug.json
