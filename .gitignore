# This workspace mixes many unrelated projects (coursework, notes, tools).
# Whitelist approach: everything is ignored by default, only the PianoPal
# paths below are tracked. New unrelated folders added later are excluded
# automatically without needing to remember to blacklist them.
/*
!/.gitignore
!/README.md
!/grade.py
!/score_to_reference/
!/scoring/
!/viewer/
!/audio_to_performance/
!/validation/
!/latency_test/
!/demo_screenshots/

# Build/dependency artifacts to exclude even within tracked project dirs
**/.venv/
**/venv/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/dist/
**/dist-ssr/
**/*.pyc
**/.DS_Store

# Scratch / generated audio artifacts from local testing
*.wav
*.mp3
*.sf2
